# Asanaka API, installed as /opt/ttf/extra-sites/asanaka.caddy (imported by TaskTopFight's ttf.caddy). Rendered from vps/asanaka.caddy.template at deploy time
# with the host name and port from .local/deploy.local.json; installed by site-sync.sh.
{{API_HOST}} {
	handle /api/* {
		# Attachments may be up to 10 MB (the API checks the exact limit); everything else stays small.
		@upload path_regexp ^/api/tasks/[0-9a-fA-F-]+/attachments$
		@small not path_regexp ^/api/tasks/[0-9a-fA-F-]+/attachments$
		request_body @upload {
			max_size 11MB
		}
		request_body @small {
			max_size 1MB
		}
		encode zstd gzip
		reverse_proxy 127.0.0.1:{{API_PORT}} {
			flush_interval -1
		}
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:{{API_PORT}}
	}
	handle {
		respond "Asanaka API" 404
	}
	header -Server
}
