# Asanaka API. Build context: the staged release (vps/local.mjs deploy makes it): the root package.json and
# lockfile, web/package.json (so the workspace list resolves) and api/.
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json web/package.json
COPY api/package.json api/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace @asanaka/api --no-audit --no-fund
COPY api ./api
USER node
WORKDIR /app/api
EXPOSE 7360
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD wget -qO- http://127.0.0.1:7360/healthz >/dev/null || exit 1
CMD ["node", "src/server.js"]
